---
import Layout from "../layouts/Layout.astro";
import HeroSmall from "../components/HeroSmall.astro";
import TimeSchedule from "../components/TimeSchedule.astro";
import Playlist from "../components/Playlist.astro";
import ProgramView from "../components/ProgramView.astro";
import Banner from "../components/Banner.astro";
---

<Layout
  fanenavn={"Bakkefest | Program"}
  meta={"Læs om programmet til Bakkefest, herunder tidspunkter, artister og andre spændende arrangementer."}
>
  <main>
    <HeroSmall url="/assets/programvideo.webm" h1="Program" fontSize="6vw" />
    <TimeSchedule />
    <Playlist />
    <ProgramView />
    <Banner background_color="var(--yellow)" src="bannerlogopink" />
  </main>
</Layout>
