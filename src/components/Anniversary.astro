---
import Hill from "../components/Hill.astro";
---

<Hill src="/assets/bakke-divider-3.svg" />

<section>
  <div class="white_space"></div>
  <div class="text_width grid_1-1">
    <a
      data-flickr-embed="true"
      href="https://www.flickr.com/photos/99154681@N07"
      title=""
      ><img
        src="https://live.staticflickr.com/65535/52210855901_2464b1ea78.jpg"
        width="100"
        height="375"
        alt="Photogalleri fra Bakkefest af Jan Krogh."
      /></a
    ><script
      async
      src="//embedr.flickr.com/assets/client-code.js"
      charset="utf-8"></script>
    <div data-aos="fade-left">
      <h2>100 års jubilæum I 2019</h2>
      <p>
        I 2019 holdte vi et brag af en Bakkefest, i anledning af vores 100 års
        jubilæum. I 2019 fulgte vi endnu engang op med et vildt musik program,
        her væltede SUSPEKT Bakkefesten. Hvilket gjorde, at vi for første gang
        nogensinde måtte lukke indgangene… <br />Glæd jer til Bakkefesten 2025,
        hvor vi gør det hele igen!
      </p>
    </div>
  </div>
  <div class="white_space"></div>
</section>
<Hill src="/assets/bakke-divider-3.svg" hill="hill2" />

<style>
  section {
    padding-bottom: 20px;
  }

  .flex_row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 15px;
    width: fit-content;
    margin-top: 15px;
    margin-bottom: 15px;
  }

  .flex_row:hover h4 {
    color: var(--yellow);
  }

  .flex_row:hover {
    scale: 1.01;
    transition: 0.2s;
  }

  .hill {
    margin-bottom: -2px;
  }

  .hill2 {
    transform: rotate(180deg);
  }

  section {
    background-color: var(--green);
  }

  .grid_1-1 img {
    height: auto;
  }

  h2,
  h4 {
    color: var(--light_pink);
    text-transform: uppercase;
  }

  p {
    color: var(--light_pink);
  }

  .grid_1-1 {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }

  a {
    text-decoration: none;
    transition: 0.2s;
  }

  @media (min-width: 800px) {
    .grid_1-1 {
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }

    .flex_row {
      margin-top: 30px;
      margin-bottom: 60px;
    }
  }
</style>
