---
import ButtonArrow from "./ButtonArrow.astro";
import Hill from "./Hill.astro";
---

<Hill src="/assets/bakke-divider-2.svg" />

<section class="pink-pulse-instagram">
  <div class="text_width">
    <div data-aos="fade-right">
      <h2>#PINKPULSE</h2>
      <h4>#BAKKEFEST25</h4>
      <p>
        Del dine bedste festivaløjeblikke med os! Brug hashtagget #pinkpulsbf25
        og tag os i dine billeder – vi elsker at se, hvordan du oplever
        Bakkefest!
      </p>
    </div>
    <div data-aos="fade-left">
      <div class="instagram-imgs">
        <img
          src="/assets/instagram-1.webp"
          width="166"
          height="249"
          alt="Sildebord til Bakkefest"
        />
        <img
          src="/assets/instagram-2.webp"
          width="166"
          height="249"
          alt="Cristopher koncert under Bakkefest"
        />
        <img
          src="/assets/instagram-3.webp"
          width="166"
          height="249"
          alt="Gruppe af mennesker der danser"
          class="hide"
        />
        <img
          src="/assets/instagram-4.webp"
          width="166"
          height="249"
          alt="Mand i blå trøje der holder en øl"
          class="hide"
        />
        <img
          src="/assets/instagram-5.webp"
          width="166"
          height="249"
          alt="Lille barn på bej hen til person i ande kostume"
          class="hide"
        />
      </div>
      <div class="flex_row">
        <a href="https://www.instagram.com/bakkefest"
          ><h4>Udforsk vores Instagram</h4></a
        >

        <ButtonArrow
          url="https://www.instagram.com/bakkefest"
          background_color="var(--yellow)"
          arrow_color="var(--pink)"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .flex_row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 15px;
    width: fit-content;
    margin-top: 15px;
    margin-inline-start: auto;
  }

  a {
    text-decoration: none;
    transition: 0.2s;
    color: var(--grey);
    transition: 0.2s;
  }

  .flex_row:hover h4 {
    color: var(--yellow);
  }

  .flex_row:hover {
    scale: 1.01;
    transition: 0.2s;
  }

  .instagram-imgs img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 8px;
  }

  .pink-pulse-instagram {
    background-color: var(--pink);
    padding-top: 60px;
    padding-bottom: 80px;
  }

  h2,
  h4,
  p {
    color: var(--light_pink);
    margin: 10px 0;
  }
  @media (max-width: 800px) {
    /* class "hide" for at skjule de sidste 3 billeder i mobilversion */
    /* max-width er her på 800, for at der kun er 2 billeder på siden indtil skærmen er på 800px */
    .hide {
      display: none;
    }
  }
  .instagram-imgs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 20px;
  }

  @media (min-width: 800px) {
    /* min-width er her på 800, for at der 5 billeder på siden indtil skærmen er på 800px. Ser pænere ud, end hvis de 5 billeder bliver helt små til der kun 2 på skærmen i mobilversion*/
    .instagram-imgs {
      grid-template-columns: repeat(5, 1fr);
      gap: 10px;
      margin-top: 30px;
    }
  }
</style>
