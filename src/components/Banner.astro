---
const { src, background_color } = Astro.props;
---

<section
  class="scrolling-banner"
  style=`background-color: ${background_color};`
>
  <div class="banner-content">
    <img src=`/assets/${src}.svg` alt="Bakkefest logo" />
    <img src=`/assets/${src}.svg` alt="Bakkefest logo" />
    <img src=`/assets/${src}.svg` alt="Bakkefest logo" />
    <img src=`/assets/${src}.svg` alt="Bakkefest logo" />
    <img src=`/assets/${src}.svg` alt="Bakkefest logo" />
    <img src=`/assets/${src}.svg` alt="Bakkefest logo" />
  </div>
</section>

<style>
  .scrolling-banner {
    overflow: hidden;
    width: 100%;
  }

  .banner-content {
    display: flex;
    gap: 1px;
    animation: scroll 10s linear infinite;
    height: 60px;
  }

  .banner-content img {
    max-height: 150px;
  }

  /* keyframes, som gør at banner-content ruller */
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (min-width: 1200px) {
    .banner-content {
      height: 145px;
    }
  }
</style>
