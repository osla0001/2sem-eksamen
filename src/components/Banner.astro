---
const { src, background_color } = Astro.props;
---

<figure class="scrolling-banner" style=`background-color: ${background_color};`>
  <div class="banner-content">
    <img src=`/assets/${src}.svg` alt="Bakkefest logo" />
    <img src=`/assets/${src}.svg` alt="Bakkefest logo" />
    <img src=`/assets/${src}.svg` alt="Bakkefest logo" />
    <img src=`/assets/${src}.svg` alt="Bakkefest logo" />
    <img src=`/assets/${src}.svg` alt="Bakkefest logo" />
    <img src=`/assets/${src}.svg` alt="Bakkefest logo" />
  </div>
</figure>

<style>
  .scrolling-banner {
    overflow: hidden;
    width: 100%;
  }

  .banner-content {
    display: flex;
    gap: 0.1rem;
    animation: scroll 10s linear infinite;
    height: 4rem;
  }

  .banner-content img {
    max-height: 10rem;
  }

  /* keyframes, som gør at banner-content ruller */
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (min-width: 1200px) {
    .banner-content {
      height: 9rem;
    }
  }
</style>
