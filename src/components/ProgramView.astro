//@ts-nocheck
import ProgramCard from "./ProgramCard.astro";

// henter data fra supabase med url og key
const url = "https://yhioxktrqmlazkwnvbit.supabase.co/rest/v1/events?select=*";
const key =
  "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InloaW94a3RycW1sYXprd252Yml0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDcxNjM1MjksImV4cCI6MjA2MjczOTUyOX0.rPSCRtiiBeBLLMGOZz9pd4-ZgiCMnuScZxME3EDLybc";

// sørger for, at nøglen sendes afsted så vi har adgang til dataerne
const options = {
  headers: {
    apikey: key,
  },
};

// gør sådan vi kan se det i vores console og om dataene er hentet korrekt
const data = await fetch(url, options).then((res) => res.json());
console.log(data);

data.sort((a, b) => {
  // Først sorteres efter 'day'
  if (a.day < b.day) return -1;
  if (a.day > b.day) return 1;

  // Hvis 'day' er ens, sorteres efter 'time_start'
  if (a.time_start < b.time_start) return -1;
  if (a.time_start > b.time_start) return 1;

  return 0; // Hvis begge er ens
});
---

<section class="text_width">
  <div class="white_space"></div>
  <h2>Programoversigt</h2>

  <!-- viser listen af events, hvor hver event vises med sit eget kort på siden -->
  <div class="grid_1-1-1" id="program-grid">
    {
      data.map((event, idx) => (
        <>
          <div class="program-card-wrapper" data-idx={idx}>
            <div class="card-click" onclick={`toggleDropdown(${idx})`}>
              <ProgramCard event={event} />
            </div>
          </div>
          <div
            class="dropdown-row"
            id={`dropdown-${idx}`}
            style="display:none;"
          >
            <div class="dropdown-content">
              <div>
                <h2>{event.name} </h2>
                <h4>
                  OPLEV {event.name} SPILLE KL.{" "}
                  {event.time_start.slice(0, 5).replace(":", ".")} {event.day}
                </h4>
                <p>{event.description}</p>
              </div>
              <div>
                <iframe
                  style="border-radius:12px"
                  src={event.spotify}
                  width="100%"
                  height="352"
                  frameBorder="0"
                  allowfullscreen=""
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </>
      ))
    }
  </div>
</section>

<script type="text/javascript">
  // Funktion der returnerer antal kolonner baseret på skærmbredden
  function getColumns() {
    if (window.innerWidth <= 683) return 1; // Små skærme: 1 kolonne
    if (window.innerWidth <= 1300) return 2; // Mellem skærme: 2 kolonner
    return 3; // Store skærme: 3 kolonner
  }

  // Funktion til at åbne/lukke en dropdown baseret på indeks (idx)
  function toggleDropdown(idx) {
    const dropdown = document.getElementById(`dropdown-${idx}`); // Hent specifik dropdown
    const isOpen = dropdown && dropdown.style.display === "block"; // Tjek om den allerede er åben

    // Hvis dropdown er åben, luk den
    if (isOpen) {
      dropdown.style.display = "none";
      return;
    }

    // Luk alle andre åbne dropdowns
    document
      .querySelectorAll(".dropdown-row")
      .forEach((el) => (el.style.display = "none"));

    // Åbn den valgte dropdown
    if (dropdown) {
      dropdown.style.display = "block";

      // Beregn hvilken grid-række dropdown'en skal placeres i
      const columns = getColumns(); // Hvor mange kolonner har layoutet?
      const gridRow = Math.floor(idx / columns) + 2; // Beregn hvilken række dropdown’en skal placeres i
      dropdown.style.gridRow = gridRow; // Sæt rækken i CSS-grid
    }
  }

  // Opdater placeringen af åben dropdown, når vinduet ændrer størrelse
  window.addEventListener("resize", () => {
    document
      .querySelectorAll(".dropdown-row[style*='display: block']") // Find alle viste dropdowns
      .forEach((dropdown) => {
        const idx = Number(dropdown.id.replace("dropdown-", "")); // Udtræk indeks fra ID
        const columns = getColumns(); // Opdater antal kolonner
        const gridRow = Math.floor(idx / columns) + 2; // Beregn ny række
        dropdown.style.gridRow = gridRow; // Opdater placering
      });
  });

  // Luk en åben dropdown, hvis brugeren klikker udenfor kort eller dropdown
  document.addEventListener("mousedown", function (event) {
    const openDropdown = document.querySelector(
      ".dropdown-row[style*='display: block']",
    );
    if (!openDropdown) return; // Hvis ingen dropdown er åben, gør ingenting

    // Tjek om klik skete på et kort eller dropdown
    const isCardClick = event.target.closest(".card-click");
    const isDropdown = event.target.closest(".dropdown-row");

    // Hvis brugeren klikker udenfor både kort og dropdown, luk dropdown
    if (!isCardClick && !isDropdown) {
      openDropdown.style.display = "none";
    }
  });
</script>

<style>
  .grid_1-1-1 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    flex-wrap: wrap;
    gap: 3px;
    margin: 0 auto;
    padding-bottom: 100px;
  }
  .dropdown-row {
    grid-column: 1 / -1;
    background: var(--yellow);
    padding: 30px 15px;
    margin-bottom: 15px;
    border-radius: 10px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
    z-index: 2;
    grid-row: 3;
  }
  .program-card-wrapper {
    position: relative;
    display: contents;
  }
  .dropdown-row {
    grid-column: 1 / -1; /* Fylder hele grid-bredden */
    background: var(--yellow);
    padding: 30px 15px;
    margin-bottom: 15px;
    border-radius: 10px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
    z-index: 2;
    transition:
      max-height 0.3s,
      padding 0.3s;
    overflow: hidden;
  }
  .dropdown-row[style*="display:none"] {
    max-height: 0;
    padding: 0 15px;
  }

  .dropdown-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 15px;
  }
  .dropdown-content h2,
  h4 {
    margin-bottom: 8px;
  }

  h2,
  h3,
  h4 {
    color: var(--pink);
    text-transform: uppercase;
  }

  @media (min-width: 684px) {
    .dropdown-content {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
