---
import "../styles/general.css";
import AOSInit from "../javascript/AOSInit.jsx";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import VolunteerClick from "../components/VolunteerClick.astro";
const { fanenavn, meta } = Astro.props;
// Har lavet fanenavnet(title) til en prop, så vi kan navngive fanerne forskeligt
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={meta} />
    <!-- Webfonts -->
    <link rel="stylesheet" href="https://use.typekit.net/gez7rds.css" />
    <title>{fanenavn}</title>
    <link rel="icon" type="image/x-icon" href="/assets/bakkefestlogo.svg" />
  </head>
  <body>
    <VolunteerClick />
    <Header />
    <slot />
    <Footer />
    <div class="aos">
      <AOSInit client:load />
    </div>
  </body>
</html>

<!-- et ekstra lag, at sikre sig aos ikke virker i mobil -->
<style>
  .aos {
    display: none;
  }

  @media (min-width: 800px) {
    .aos {
      display: block;
    }
  }
</style>
